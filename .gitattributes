# Scripts and config consumed by Linux containers must keep LF endings.
# Without this, Git for Windows checks them out as CRLF and the shebang
# becomes "#!/bin/bash\r", which fails to execute inside the container.
*.sh text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.conf text eol=lf
